-- Shared fixture for the access matrix (BRIEF §3) and the workflow tests.
-- Included with \ir inside each test's transaction; everything rolls back.
--
--   Dika   owner; pm on Margin Bridge (MB)
--   David  pm on MB and on MAM
--   Muti   officer on MB          Yani  officer on MB
--   Vera   viewer on MB           Rina  officer on MB, no login
--   Mira   officer on MAM only    Bimo  pm on BMG (no David, Muti or Yani there)
--   Gita   group_viewer, no memberships

-- Start from an empty board whatever the database holds (the test's transaction rolls it back).
alter table public.app_roles disable trigger app_roles_keep_one_owner;
delete from public.projects;
delete from public.people;
delete from public.app_roles;
delete from public.pending_app_roles;
delete from public.email_log;
delete from auth.users;
alter table public.app_roles enable trigger app_roles_keep_one_owner;

-- Deterministic ids, usable inside dollar-quoted test SQL.
create function pg_temp.u(n text) returns uuid language sql immutable as $$ select md5('user:' || n)::uuid $$;
create function pg_temp.p(n text) returns uuid language sql immutable as $$ select md5('person:' || n)::uuid $$;
create function pg_temp.prj(n text) returns uuid language sql immutable as $$ select md5('project:' || n)::uuid $$;
create function pg_temp.ms(n text) returns uuid language sql immutable as $$ select md5('ms:' || n)::uuid $$;
create function pg_temp.t(n text) returns uuid language sql immutable as $$ select md5('task:' || n)::uuid $$;
create function pg_temp.ask(n text) returns uuid language sql immutable as $$ select md5('ask:' || n)::uuid $$;

-- Act as a signed-in user (or anon). Return to the test superuser with `reset role`.
create function pg_temp.login(n text) returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('sub', pg_temp.u(n), 'role', 'authenticated')::text, true);
  perform set_config('role', 'authenticated', true);
end
$$;
create function pg_temp.login_anon() returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('role', 'anon', true);
end
$$;

-- People and contacts first: logins can only be created for known e-mails (…_auth.sql), and
-- the link trigger then connects each login to its person.
insert into public.people (id, display_name, job_title)
select pg_temp.p(n), initcap(n), 'Staf'
  from unnest(array['dika', 'david', 'muti', 'yani', 'vera', 'mira', 'bimo', 'gita', 'rina']) n;

insert into public.people_contact (person_id, email)
select pg_temp.p(n), n || '@samb.test'
  from unnest(array['dika', 'david', 'muti', 'yani', 'vera', 'mira', 'bimo', 'gita', 'rina']) n;

insert into public.pending_app_roles (email, role) values ('dika@samb.test', 'owner');

insert into auth.users (id, email)
select pg_temp.u(n), n || '@samb.test'
  from unnest(array['dika', 'david', 'muti', 'yani', 'vera', 'mira', 'bimo', 'gita']) n;

insert into public.app_roles (user_id, role) values (pg_temp.u('gita'), 'group_viewer');

