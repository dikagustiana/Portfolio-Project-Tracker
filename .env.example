# Copy to .env.local and fill in. Never commit .env or .env.local (both are git-ignored).
#
# Local development: `npm run db:start` prints the local API URL and keys.
# Hosted: Supabase dashboard -> Project Settings -> API (use the dedicated SAMB project only).

# --- Browser (inlined into the bundle; publishable key ONLY) -----------------------------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server-side only (seed import script, Edge Functions) ------------------------------
# Never prefix these with VITE_, never set them in Vercel's client env, never paste them into src/.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
